## Flowset Tasklist configuration ##

# Locale of Flowset Task user interface. Available values: en, de, es, ru
FLOWSET_TASKLIST_LOCALE=en

FLOWSET_TASKLIST_VERSION=1.0.0

## Configuration of the BPM engine to which Flowset Tasklist connects for data loading ##
# URL for BPM engine REST API, e.g. http://localhost:8080/engine-rest
BPM_ENGINE_API_URL=http://localhost:8080/engine-rest

# BPM engine type, available values: CAMUNDA_7, OPERATON.
BPM_ENGINE_TYPE=CAMUNDA_7