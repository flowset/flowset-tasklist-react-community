## OpenBPM Tasklist configuration ##

# Locale of OpenBPM Task user interface. Available values: en, de, es, ru
OPENBPM_TASKLIST_LOCALE=en

OPENBPM_TASKLIST_VERSION=1.0.0

## Configuration of the BPM engine to which OpenBPM Tasklist connects for data loading ##
# URL for BPM engine REST API, e.g. http://localhost:8080/engine-rest
BPM_ENGINE_API_URL=http://localhost:8080/engine-rest

# BPM engine type, available values: CAMUNDA_7, OPERATON.
BPM_ENGINE_TYPE=CAMUNDA_7